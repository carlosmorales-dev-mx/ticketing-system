# --- Etapa de dependencias e instalación ---
FROM docker.io/library/node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@9.7.0 --activate

WORKDIR /src
COPY package.json ./
# Sin pnpm-lock.yaml todavía en el repo (se genera en el primer
# `pnpm install` local) — si lo committeas más adelante, cambia esto
# a `pnpm install --frozen-lockfile` para builds reproducibles.
RUN pnpm install

COPY . .
RUN pnpm build

# --- Etapa final: solo el output standalone de Nitro ---
FROM docker.io/library/node:20-alpine

RUN adduser -D -u 10001 appuser
USER appuser

WORKDIR /app
COPY --from=builder /src/.output ./.output

EXPOSE 3000
ENV HOST=0.0.0.0
ENV PORT=3000
CMD ["node", ".output/server/index.mjs"]
